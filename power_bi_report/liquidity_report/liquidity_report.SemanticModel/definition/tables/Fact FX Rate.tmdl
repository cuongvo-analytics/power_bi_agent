/// Month-end FX rates to the reporting currency: one row per month-end x currency.
table 'Fact FX Rate'
	lineageTag: df42f5ea-4345-4e09-8cb5-bdf668501367

	column Date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: 80fd9e17-6d90-4a23-9582-d2afdefdab40
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Currency Code'
		dataType: string
		isHidden
		lineageTag: 05e2004d-d6f4-4ff0-a305-179cb1c3321f
		summarizeBy: none
		sourceColumn: Currency Code

	column 'Rate To RC'
		dataType: double
		isHidden
		lineageTag: a82a913f-cf0e-47cd-b542-ef7a6883149e
		summarizeBy: none
		sourceColumn: Rate To RC

	partition 'Fact FX Rate' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_fx_rate.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"date", "currency_code", "rate_to_rc"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"date", type date}, {"currency_code", type text}, {"rate_to_rc", type number}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"date", "Date"}, {"currency_code", "Currency Code"}, {"rate_to_rc", "Rate To RC"}})
				in
				    Renamed

