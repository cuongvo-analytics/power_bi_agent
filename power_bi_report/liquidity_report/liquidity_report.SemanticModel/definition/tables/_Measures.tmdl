/// Measure table: all report measures live here, in numbered display folders.
table _Measures
	lineageTag: faef2a30-afda-41cb-9147-2ce20a4b2e07

	/// As-of date of the dataset: the single 'As-of' day in Dim Date (2026-10-31). Projection day 1 = as-of + 1.
	measure 'As-of Date' = CALCULATE ( MAX ( 'Dim Date'[Date] ), REMOVEFILTERS ( 'Dim Date' ), 'Dim Date'[Period Type] = "As-of" )
		formatString: dd MMM yyyy
		displayFolder: 1. Dates & Scenario
		lineageTag: 0d663b3d-21c6-477b-9b7f-163484dc900d

	/// Last bank snapshot month-end on or before the latest date in context. All snapshot measures use this date (never LASTDATE). Ignores product, currency and other filters so the date is the same for every slice.
	measure 'Reporting Date' =
			VAR _sel = MAX ( 'Dim Date'[Date] )
			RETURN
			    CALCULATE (
			        MAX ( 'Fact Bank Position'[Date] ),
			        REMOVEFILTERS ( 'Fact Bank Position' ),
			        'Dim Date'[Date] <= _sel
			    )
		formatString: dd MMM yyyy
		displayFolder: 1. Dates & Scenario
		lineageTag: 6080c59a-3c2c-4d98-8a68-57830f973cfd

	/// Scenario key in context (slicer, legend or visual filter); BASE (Basel rates) when none or several are selected.
	measure 'Selected Scenario' = SELECTEDVALUE ( 'Dim Scenario'[Scenario Key], "BASE" )
		displayFolder: 1. Dates & Scenario
		lineageTag: ee6cf6eb-c012-4668-b6fc-99791816a7c8

	/// Name of the scenario the measures are using (follows [Selected Scenario], so BASE when no single scenario is selected).
	measure 'Scenario Label' =
			VAR _s = [Selected Scenario]
			RETURN
			    CALCULATE (
			        MAX ( 'Dim Scenario'[Scenario Name] ),
			        REMOVEFILTERS ( 'Dim Scenario' ),
			        'Dim Scenario'[Scenario Key] = _s
			    )
		displayFolder: 1. Dates & Scenario
		lineageTag: 527a1113-4f39-4515-98c9-e6b9e65a8e58

	/// Bank balance at the reporting date, reporting currency (USD), positive. Snapshot: semi-additive, never summed across dates.
	measure Balance =
			VAR _d = [Reporting Date]
			RETURN
			    CALCULATE ( SUM ( 'Fact Bank Position'[Balance RC] ), REMOVEFILTERS ( 'Dim Date' ), 'Dim Date'[Date] = _d )
		formatString: #,##0
		displayFolder: 2. Balances
		lineageTag: 0de35fe5-46d8-43a0-a73a-250c8caa0e78

	/// Retail + wholesale deposit balances at the reporting date (USD, positive, snapshot).
	measure 'Total Deposits' = CALCULATE ( [Balance], 'Dim Product'[Category] IN { "Retail Deposits", "Wholesale Deposits" } )
		formatString: #,##0
		displayFolder: 2. Balances
		lineageTag: a814714d-4501-43cb-9ff3-065c409bbf82

	/// Loan balances at the reporting date (USD, positive, snapshot).
	measure 'Gross Loans' = CALCULATE ( [Balance], 'Dim Product'[Category] = "Loans" )
		formatString: #,##0
		displayFolder: 2. Balances
		lineageTag: 1d15acf4-e733-40da-aebd-9a835ad46647

	/// Projected daily bank net cash flow for the selected scenario (BASE = behavioural, others = stressed), USD. Sign: + in / - out. Additive over days.
	measure 'Stressed Net CF' =
			VAR _s = [Selected Scenario]
			RETURN
			    CALCULATE (
			        SUM ( 'Fact Bank CF Stressed'[Amount RC] ),
			        REMOVEFILTERS ( 'Dim Scenario' ),
			        'Dim Scenario'[Scenario Key] = _s
			    )
		formatString: #,##0;(#,##0);-
		displayFolder: 3. Cash Flows
		lineageTag: 39d6b439-b7eb-427c-8b43-4b1823bb8ac9

	/// Gross loans / total deposits at the reporting date. Lower = more liquid.
	measure 'Loan to Deposit %' = DIVIDE ( [Gross Loans], [Total Deposits] )
		formatString: 0.0%
		displayFolder: 5. Bank Liquidity
		lineageTag: c8524827-1085-477b-97eb-f60a482284ef

	/// Market value of unencumbered HQLA securities at the reporting date, before haircuts (USD, positive, snapshot).
	measure 'HQLA Market Value' =
			VAR _d = [Reporting Date]
			RETURN
			    CALCULATE (
			        SUM ( 'Fact HQLA Holding'[Market Value RC] ),
			        REMOVEFILTERS ( 'Dim Date' ),
			        'Dim Date'[Date] = _d,
			        'Fact HQLA Holding'[Encumbered] = 0
			    )
		formatString: #,##0
		displayFolder: 5. Bank Liquidity\HQLA
		lineageTag: 932e6bcd-7e9c-4049-96de-260721ebf416

	/// Market value of encumbered (pledged) HQLA securities at the reporting date; excluded from the LCR buffer (USD, positive, snapshot).
	measure 'Encumbered HQLA' =
			VAR _d = [Reporting Date]
			RETURN
			    CALCULATE (
			        SUM ( 'Fact HQLA Holding'[Market Value RC] ),
			        REMOVEFILTERS ( 'Dim Date' ),
			        'Dim Date'[Date] = _d,
			        'Fact HQLA Holding'[Encumbered] = 1
			    )
		formatString: #,##0
		displayFolder: 5. Bank Liquidity\HQLA
		lineageTag: e5db54cc-d413-41d3-8c98-aabbc94e2591

	/// Market value of all HQLA securities (encumbered and unencumbered) at the reporting date, before haircuts (USD, positive, snapshot). Used in the top-securities table and as the start of the HQLA bridge.
	measure 'Security Market Value' =
			VAR _d = [Reporting Date]
			RETURN
			    CALCULATE (
			        SUM ( 'Fact HQLA Holding'[Market Value RC] ),
			        REMOVEFILTERS ( 'Dim Date' ),
			        'Dim Date'[Date] = _d
			    )
		formatString: #,##0
		displayFolder: 5. Bank Liquidity\HQLA
		lineageTag: c2b188c4-273c-4389-aeaa-1fc08784735d

	/// Helper. Unencumbered HQLA at the reporting date after base haircut and the selected scenario's haircut add-on for the product's LCR Group: market value x MAX(0, 1 - base haircut - add-on). Before Level 2 caps. USD, positive.
	measure 'HQLA Post Haircut' =
			VAR _d = [Reporting Date]
			VAR _s = [Selected Scenario]
			VAR _par =
			    CALCULATETABLE (
			        'Scenario Parameter',
			        REMOVEFILTERS ( 'Scenario Parameter' ),
			        'Scenario Parameter'[Scenario Key] = _s
			    )
			RETURN
			    SUMX (
			        FILTER ( VALUES ( 'Dim Product' ), 'Dim Product'[LCR Flow] = "hqla" ),
			        VAR _grp = 'Dim Product'[LCR Group]
			        VAR _addon =
			            COALESCE (
			                MAXX ( FILTER ( _par, 'Scenario Parameter'[LCR Group] = _grp ), 'Scenario Parameter'[Haircut Addon] ),
			                0
			            )
			        RETURN
			            CALCULATE (
			                SUMX (
			                    'Fact HQLA Holding',
			                    'Fact HQLA Holding'[Market Value RC] * MAX ( 0, 1 - 'Fact HQLA Holding'[Base Haircut] - _addon )
			                ),
			                REMOVEFILTERS ( 'Dim Date' ),
			                'Dim Date'[Date] = _d,
			                'Fact HQLA Holding'[Encumbered] = 0
			            )
			    )
		formatString: #,##0
		isHidden
		displayFolder: 5. Bank Liquidity\HQLA
		lineageTag: a3259693-e8b3-48ad-b7b9-812adc12d2d2

	/// Level 1 HQLA (central bank reserves, government bonds) after haircuts (incl. scenario add-on), unencumbered, at the reporting date. USD, positive, stressed for non-BASE scenarios.
	measure 'HQLA L1' = CALCULATE ( [HQLA Post Haircut], KEEPFILTERS ( 'Dim Product'[HQLA Level] = "1" ) )
		formatString: #,##0
		displayFolder: 5. Bank Liquidity\HQLA
		lineageTag: 03d9f584-3c63-4f06-9040-c73c869bafd0

	/// Level 2A HQLA after haircuts (incl. scenario add-on), before caps, unencumbered, at the reporting date. USD, positive.
	measure 'HQLA L2A' = CALCULATE ( [HQLA Post Haircut], KEEPFILTERS ( 'Dim Product'[HQLA Level] = "2A" ) )
		formatString: #,##0
		displayFolder: 5. Bank Liquidity\HQLA
		lineageTag: 04c443fd-7e51-4620-a8d0-146f7daba7e4

	/// Level 2B HQLA after haircuts (incl. scenario add-on), before caps, unencumbered, at the reporting date. USD, positive.
	measure 'HQLA L2B' = CALCULATE ( [HQLA Post Haircut], KEEPFILTERS ( 'Dim Product'[HQLA Level] = "2B" ) )
		formatString: #,##0
		displayFolder: 5. Bank Liquidity\HQLA
		lineageTag: ad09002f-509e-4d7f-80fb-dbd70f7b2378

	/// Stock of HQLA for the LCR at the reporting date and selected scenario: L1 + capped L2, where L2B is capped at 15/85 x (L1 + L2A) and L2A + L2B at 2/3 x L1. USD, positive; higher is better.
	measure 'HQLA Stock' =
			VAR _l1 = [HQLA L1]
			VAR _l2a = [HQLA L2A]
			VAR _l2b = [HQLA L2B]
			VAR _l2bCapped = MIN ( _l2b, 15 / 85 * ( _l1 + _l2a ) )
			VAR _l2Capped = MIN ( _l2a + _l2bCapped, 2 / 3 * _l1 )
			RETURN
			    IF ( _l1 + _l2a + _l2b = 0, BLANK (), _l1 + _l2Capped )
		formatString: #,##0
		displayFolder: 5. Bank Liquidity\HQLA
		lineageTag: 33df358d-ecf5-4f7f-92f4-bc8b65c090c4

	/// Level 1 HQLA / HQLA stock at the reporting date. Higher = better buffer quality.
	measure 'Level 1 Share %' = DIVIDE ( [HQLA L1], [HQLA Stock] )
		formatString: 0.0%
		displayFolder: 5. Bank Liquidity\HQLA
		lineageTag: 8bf8adca-0734-4d55-a33f-c5323381c25b

	/// Helper for [HQLA Bridge Amount]: signed amount of the single HQLA Bridge Step in context.
	measure 'HQLA Bridge Step Amount' =
			VAR _step = SELECTEDVALUE ( 'HQLA Bridge Step'[Step] )
			VAR _post = [HQLA L1] + [HQLA L2A] + [HQLA L2B]
			RETURN
			    SWITCH (
			        _step,
			        "Market value", [Security Market Value],
			        "Haircuts", - ( [HQLA Market Value] - _post ),
			        "Encumbered", - [Encumbered HQLA],
			        "Caps", - ( _post - [HQLA Stock] ),
			        "HQLA stock", [HQLA Stock]
			    )
		formatString: #,##0;(#,##0);-
		isHidden
		displayFolder: 5. Bank Liquidity\HQLA
		lineageTag: 7d070329-7a1a-4223-8b9c-0063f842eb80

	/// HQLA bridge from total market value to HQLA stock (selected scenario, reporting date), USD: Market value (+), Haircuts (-), Encumbered (-), Caps (-), HQLA stock (end value). At the total level returns the sum of the bridge steps = HQLA stock.
	measure 'HQLA Bridge Amount' =
			IF (
			    HASONEVALUE ( 'HQLA Bridge Step'[Step] ),
			    [HQLA Bridge Step Amount],
			    SUMX (
			        FILTER ( VALUES ( 'HQLA Bridge Step'[Step] ), 'HQLA Bridge Step'[Step] <> "HQLA stock" ),
			        [HQLA Bridge Step Amount]
			    )
			)
		formatString: #,##0;(#,##0);-
		displayFolder: 5. Bank Liquidity\HQLA
		lineageTag: 097122f1-2d66-400f-9f03-eea984a228eb

	/// LCR 30-day stressed outflows at the reporting date, selected scenario. Per product (LCR Flow = outflow): base x MIN(1, LCR Rate x scenario runoff multiplier of the product's LCR Group); base = Balance RC if LCR Basis = balance (non-maturity deposits, undrawn facilities) else Principal Due 30D RC. USD shown positive; lower is better.
	measure 'Outflows 30D' =
			VAR _d = [Reporting Date]
			VAR _s = [Selected Scenario]
			VAR _par =
			    CALCULATETABLE (
			        'Scenario Parameter',
			        REMOVEFILTERS ( 'Scenario Parameter' ),
			        'Scenario Parameter'[Scenario Key] = _s
			    )
			RETURN
			    SUMX (
			        FILTER ( VALUES ( 'Dim Product' ), 'Dim Product'[LCR Flow] = "outflow" ),
			        VAR _grp = 'Dim Product'[LCR Group]
			        VAR _mult =
			            COALESCE (
			                MAXX ( FILTER ( _par, 'Scenario Parameter'[LCR Group] = _grp ), 'Scenario Parameter'[Runoff Multiplier] ),
			                1
			            )
			        VAR _factor = MIN ( 1, 'Dim Product'[LCR Rate] * _mult )
			        VAR _base =
			            IF (
			                'Dim Product'[LCR Basis] = "balance",
			                CALCULATE ( SUM ( 'Fact Bank Position'[Balance RC] ), REMOVEFILTERS ( 'Dim Date' ), 'Dim Date'[Date] = _d ),
			                CALCULATE ( SUM ( 'Fact Bank Position'[Principal Due 30D RC] ), REMOVEFILTERS ( 'Dim Date' ), 'Dim Date'[Date] = _d )
			            )
			        RETURN
			            _base * _factor
			    )
		formatString: #,##0
		displayFolder: 5. Bank Liquidity\LCR
		lineageTag: 29abf3b3-95ea-4a50-a718-52452f997961

	/// LCR 30-day inflows before the 75 % cap, reporting date, selected scenario. Per product (LCR Flow = inflow): Principal Due 30D RC x MIN(1, LCR Rate x scenario inflow multiplier). USD, positive; higher is better.
	measure 'Inflows 30D' =
			VAR _d = [Reporting Date]
			VAR _s = [Selected Scenario]
			VAR _par =
			    CALCULATETABLE (
			        'Scenario Parameter',
			        REMOVEFILTERS ( 'Scenario Parameter' ),
			        'Scenario Parameter'[Scenario Key] = _s
			    )
			RETURN
			    SUMX (
			        FILTER ( VALUES ( 'Dim Product' ), 'Dim Product'[LCR Flow] = "inflow" ),
			        VAR _grp = 'Dim Product'[LCR Group]
			        VAR _mult =
			            COALESCE (
			                MAXX ( FILTER ( _par, 'Scenario Parameter'[LCR Group] = _grp ), 'Scenario Parameter'[Inflow Multiplier] ),
			                1
			            )
			        VAR _factor = MIN ( 1, 'Dim Product'[LCR Rate] * _mult )
			        VAR _base =
			            CALCULATE ( SUM ( 'Fact Bank Position'[Principal Due 30D RC] ), REMOVEFILTERS ( 'Dim Date' ), 'Dim Date'[Date] = _d )
			        RETURN
			            _base * _factor
			    )
		formatString: #,##0
		displayFolder: 5. Bank Liquidity\LCR
		lineageTag: 7adc4c85-4572-4712-bed1-e55256ebdca1

	/// LCR inflows after the Basel cap: MIN(Inflows 30D, 75 % x Outflows 30D). USD, positive.
	measure 'Inflows Capped' =
			VAR _in = [Inflows 30D]
			VAR _out = [Outflows 30D]
			RETURN
			    IF ( NOT ISBLANK ( _in ), MIN ( _in, 0.75 * _out ) )
		formatString: #,##0
		displayFolder: 5. Bank Liquidity\LCR
		lineageTag: 90a70829-d6f8-47bd-a307-8a83015ca6cd

	/// Total net cash outflows over 30 days = Outflows 30D - Inflows Capped (selected scenario, reporting date). USD shown positive; lower is better. Not additive across LCR groups (cap applies to the total).
	measure 'Net Outflows 30D' =
			VAR _out = [Outflows 30D]
			VAR _in = [Inflows Capped]
			RETURN
			    IF ( NOT ISBLANK ( _out ), _out - _in )
		formatString: #,##0
		displayFolder: 5. Bank Liquidity\LCR
		lineageTag: bd7bf228-5d7e-46de-aeda-8a87dc101b2d

	/// Liquidity Coverage Ratio = HQLA Stock / Net Outflows 30D at the reporting date for the selected scenario (BASE = Basel rates, others stressed). Regulatory minimum 100 %; higher is better.
	measure 'LCR %' = DIVIDE ( [HQLA Stock], [Net Outflows 30D] )
		formatString: 0.0%
		displayFolder: 5. Bank Liquidity\LCR
		lineageTag: 09049d2d-1497-48ed-9706-d0050450791b

	/// HQLA Stock - Net Outflows 30D (selected scenario, reporting date), USD. Positive = surplus above 100 % LCR; negative = shortfall.
	measure 'LCR Headroom' =
			VAR _h = [HQLA Stock]
			VAR _n = [Net Outflows 30D]
			RETURN
			    IF ( NOT ISBLANK ( _h ) || NOT ISBLANK ( _n ), _h - _n )
		formatString: #,##0;(#,##0);-
		displayFolder: 5. Bank Liquidity\LCR
		lineageTag: 59e89ec4-51a9-499f-9982-3d39b17d77ce

	/// Reference LCR from the source (Ref Liquidity Metrics) at the reporting date and selected scenario. Reconciliation only; total bank (ignores currency and product filters).
	measure 'Ref LCR %' =
			VAR _d = [Reporting Date]
			VAR _s = [Selected Scenario]
			RETURN
			    CALCULATE (
			        MAX ( 'Ref Liquidity Metrics'[LCR Pct] ),
			        REMOVEFILTERS ( 'Dim Date' ),
			        REMOVEFILTERS ( 'Dim Scenario' ),
			        'Dim Date'[Date] = _d,
			        'Dim Scenario'[Scenario Key] = _s
			    )
		formatString: 0.0%
		displayFolder: 5. Bank Liquidity\LCR
		lineageTag: 3eb688cf-07a1-4fcf-bdac-3633f5c31f26

	/// LCR % - Ref LCR %, in percentage points. Should be ~0 for the total bank; differs when a currency or product filter is applied.
	measure 'LCR Diff vs Ref' =
			VAR _a = [LCR %]
			VAR _r = [Ref LCR %]
			RETURN
			    IF ( NOT ISBLANK ( _a ) && NOT ISBLANK ( _r ), _a - _r )
		formatString: +0.00%;-0.00%;0.00%
		displayFolder: 5. Bank Liquidity\LCR
		lineageTag: e882245f-f720-48e0-a3ed-a92cd9eddd5a

	/// Outflows 30D of the selected scenario minus BASE outflows (reporting date), USD. Positive = extra stressed outflow (unfavourable).
	measure 'Outflows vs BASE' =
			VAR _cur = [Outflows 30D]
			VAR _base =
			    CALCULATE ( [Outflows 30D], REMOVEFILTERS ( 'Dim Scenario' ), 'Dim Scenario'[Scenario Key] = "BASE" )
			RETURN
			    IF ( NOT ISBLANK ( _cur ), _cur - _base )
		formatString: +#,##0;-#,##0;0
		displayFolder: 5. Bank Liquidity\LCR
		lineageTag: 2f7df0b0-186d-4eb2-97e3-4514a3f75f81

	/// Contractual cash inflows from the as-of ladder (positive flows), USD. View: contractual. Sign + in.
	measure 'Contractual Inflows' = CALCULATE ( SUM ( 'Fact Bank CF Contractual'[Amount RC] ), 'Fact Bank CF Contractual'[Amount RC] > 0 )
		formatString: #,##0;(#,##0);-
		displayFolder: 5. Bank Liquidity\Maturity & Survival
		lineageTag: 964061e5-fb4c-4145-b586-c0f900ae4319

	/// Contractual cash outflows from the as-of ladder (negative flows), USD. View: contractual. Sign - out.
	measure 'Contractual Outflows' = CALCULATE ( SUM ( 'Fact Bank CF Contractual'[Amount RC] ), 'Fact Bank CF Contractual'[Amount RC] < 0 )
		formatString: #,##0;(#,##0);-
		displayFolder: 5. Bank Liquidity\Maturity & Survival
		lineageTag: e10f429c-7b6f-45a9-95fb-a4156e52d770

	/// Contractual net cash flow (inflows + outflows), USD. View: contractual (non-maturity deposits in O/N). Sign + in / - out.
	measure 'Contractual Net CF' = SUM ( 'Fact Bank CF Contractual'[Amount RC] )
		formatString: #,##0;(#,##0);-
		displayFolder: 5. Bank Liquidity\Maturity & Survival
		lineageTag: 5dae6982-e67d-4ef0-b11b-097f58aaa67d

	/// Running total of Contractual Net CF over the maturity buckets up to the bucket in context (by Dim Time Bucket[Sort Order]), USD. View: contractual. Negative = cumulative funding gap.
	measure 'Cumulative Contractual Gap' =
			VAR _o = MAX ( 'Dim Time Bucket'[Sort Order] )
			RETURN
			    IF (
			        NOT ISBLANK ( [Contractual Net CF] ),
			        CALCULATE ( [Contractual Net CF], REMOVEFILTERS ( 'Dim Time Bucket' ), 'Dim Time Bucket'[Sort Order] <= _o )
			    )
		formatString: #,##0;(#,##0);-
		displayFolder: 5. Bank Liquidity\Maturity & Survival
		lineageTag: 8146044a-92e3-4ed0-b867-99c655fb0fa3

	/// Cumulative projected net cash flow of the selected scenario from the day after the as-of date to the date in context (within the 90-day horizon), USD. View: behavioural (BASE) / stressed. Sign + in / - out.
	measure 'Cumulative Stressed CF' =
			VAR _asof = [As-of Date]
			VAR _d = MAX ( 'Dim Date'[Date] )
			VAR _end = CALCULATE ( MAX ( 'Fact Bank CF Stressed'[Date] ), REMOVEFILTERS ( 'Fact Bank CF Stressed' ) )
			RETURN
			    IF (
			        _d > _asof && _d <= _end,
			        CALCULATE ( [Stressed Net CF], REMOVEFILTERS ( 'Dim Date' ), 'Dim Date'[Date] > _asof, 'Dim Date'[Date] <= _d )
			    )
		formatString: #,##0;(#,##0);-
		displayFolder: 5. Bank Liquidity\Maturity & Survival
		lineageTag: f4b26b73-4993-4aab-be8a-de968d5ab2fc

	/// Projected liquidity position = HQLA Stock at the as-of date (selected scenario) + Cumulative Stressed CF to the date in context, USD. Below 0 = buffer exhausted. View: behavioural (BASE) / stressed.
	measure 'Liquidity Position' =
			VAR _asof = [As-of Date]
			VAR _cum = [Cumulative Stressed CF]
			VAR _hq = CALCULATE ( [HQLA Stock], REMOVEFILTERS ( 'Dim Date' ), 'Dim Date'[Date] = _asof )
			RETURN
			    IF ( NOT ISBLANK ( _cum ), _hq + _cum )
		formatString: #,##0;(#,##0);-
		displayFolder: 5. Bank Liquidity\Maturity & Survival
		lineageTag: 39a45482-6bd3-4db0-a94b-7809b6199ecd

	/// Survival horizon in days for the selected scenario: (first projection day on which HQLA Stock at as-of + cumulative stressed net CF < 0) - as-of - 1. BLANK = survives the full 90-day horizon. Higher is better.
	measure 'Survival Days' =
			VAR _asof = [As-of Date]
			VAR _s = [Selected Scenario]
			VAR _hq = CALCULATE ( [HQLA Stock], REMOVEFILTERS ( 'Dim Date' ), 'Dim Date'[Date] = _asof )
			VAR _days =
			    CALCULATETABLE ( VALUES ( 'Dim Date'[Date] ), REMOVEFILTERS ( 'Dim Date' ), 'Dim Date'[Period Type] = "Projection" )
			VAR _pos =
			    ADDCOLUMNS (
			        _days,
			        "@Position",
			            VAR _d = 'Dim Date'[Date]
			            RETURN
			                _hq
			                    + CALCULATE (
			                        SUM ( 'Fact Bank CF Stressed'[Amount RC] ),
			                        REMOVEFILTERS ( 'Dim Date' ),
			                        REMOVEFILTERS ( 'Dim Scenario' ),
			                        'Dim Scenario'[Scenario Key] = _s,
			                        'Dim Date'[Date] > _asof,
			                        'Dim Date'[Date] <= _d
			                    )
			    )
			VAR _breach = MINX ( FILTER ( _pos, [@Position] < 0 ), 'Dim Date'[Date] )
			RETURN
			    IF ( NOT ISBLANK ( _hq ) && NOT ISBLANK ( _breach ), DATEDIFF ( _asof, _breach, DAY ) - 1 )
		formatString: 0
		displayFolder: 5. Bank Liquidity\Maturity & Survival
		lineageTag: 6faf8545-488e-4b53-86b9-277578f15b62

	/// Header text: as-of date and the scenario the measures use.
	measure 'Title As-of' = "As of " & FORMAT ( [As-of Date], "dd MMM yyyy" ) & " · " & [Scenario Label]
		isHidden
		displayFolder: 9. Helpers
		lineageTag: a32e22e3-318b-4352-b78d-3077bcc7b6ff

	/// Status colour for LCR %: >= 110 % green #1E7A00, >= 100 % amber #D97706, below 100 % red #C23B22, grey when blank.
	measure 'LCR Color' =
			VAR _l = [LCR %]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( _l ), "#525355",
			        _l >= 1.10, "#1E7A00",
			        _l >= 1.00, "#D97706",
			        "#C23B22"
			    )
		isHidden
		displayFolder: 9. Helpers
		lineageTag: 2ab716fd-a3fc-4dac-8fed-7c6e7fa4696b

	/// Fixed scenario colour: BASE #0473EA, IDIO #D97706, MARKET #4E547B, COMBINED #C23B22 (others Prosper Blue).
	measure 'Scenario Color' =
			SWITCH (
			    [Selected Scenario],
			    "BASE", "#0473EA",
			    "IDIO", "#D97706",
			    "MARKET", "#4E547B",
