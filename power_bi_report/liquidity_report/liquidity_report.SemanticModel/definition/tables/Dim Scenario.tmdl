/// Stress scenarios (ACT, BASE, IDIO, MARKET, COMBINED). Stress only, no budget versions. The scenario applies to LCR through Scenario Parameter multipliers in DAX.
table 'Dim Scenario'
	lineageTag: 59634a01-1166-4ef1-8594-ce78fb2b7302

	column 'Scenario Key'
		dataType: string
		isHidden
		lineageTag: fa2fcdd1-7597-4464-ae06-c56ae55cafcf
		summarizeBy: none
		sourceColumn: Scenario Key

	column 'Scenario Name'
		dataType: string
		lineageTag: 4648489f-8e87-4df1-bf1b-16b468f83c97
		summarizeBy: none
		sourceColumn: Scenario Name
		sortByColumn: 'Sort Order'

	column 'Scenario Type'
		dataType: string
		lineageTag: 96a724fd-eee6-4c48-8dcc-9c8078cd94cd
		summarizeBy: none
		sourceColumn: Scenario Type

	column 'Sort Order'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6e604e3b-4890-41be-b3f6-add38b00ca23
		summarizeBy: none
		sourceColumn: Sort Order

	partition 'Dim Scenario' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_scenario.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"scenario_key", "scenario_name", "scenario_type", "sort_order"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"scenario_key", type text}, {"scenario_name", type text}, {"scenario_type", type text}, {"sort_order", Int64.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"scenario_key", "Scenario Key"}, {"scenario_name", "Scenario Name"}, {"scenario_type", "Scenario Type"}, {"sort_order", "Sort Order"}})
				in
				    Renamed

