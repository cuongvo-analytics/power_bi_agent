	column 'Period Type'
		dataType: string
		lineageTag: c28c9ef9-a6df-467c-9e37-b58a0c7fc75c
		summarizeBy: none
		sourceColumn: Period Type

	partition 'Dim Date' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"date", "date_key", "year", "quarter", "month_number", "month", "year_month_key", "year_month", "month_end", "is_month_end", "week_start", "iso_week", "is_working_day", "days_from_asof", "period_type"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"date", type date}, {"date_key", Int64.Type}, {"year", Int64.Type}, {"quarter", type text}, {"month_number", Int64.Type}, {"month", type text}, {"year_month_key", Int64.Type}, {"year_month", type text}, {"month_end", type date}, {"is_month_end", Int64.Type}, {"week_start", type date}, {"iso_week", Int64.Type}, {"is_working_day", Int64.Type}, {"days_from_asof", Int64.Type}, {"period_type", type text}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"date", "Date"}, {"date_key", "Date Key"}, {"year", "Year"}, {"quarter", "Quarter"}, {"month_number", "Month Number"}, {"month", "Month"}, {"year_month_key", "Year Month Key"}, {"year_month", "Year Month"}, {"month_end", "Month End"}, {"is_month_end", "Is Month End"}, {"week_start", "Week Start"}, {"iso_week", "ISO Week"}, {"is_working_day", "Is Working Day"}, {"days_from_asof", "Days From Asof"}, {"period_type", "Period Type"}})
				in
				    Renamed

