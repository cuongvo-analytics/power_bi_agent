/// Calendar (one row per day, 2025-11-01 to 2049-12-31) shipped with the source. Marked date table. Period Type: History / As-of / Projection / Beyond horizon.
table 'Dim Date'
	lineageTag: 2912d1a5-5be6-428f-9681-0fd58e30a4b2
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: yyyy-mm-dd
		lineageTag: 3b0a844f-bd56-42ec-b6db-5c4e7137bb4c
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Date Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 9e0e6cb3-b8a1-43d8-9478-837e2b1a29a6
		summarizeBy: none
		sourceColumn: Date Key

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 05940dab-520d-426f-8061-6c9d5f1a414e
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: string
		lineageTag: 0f6c65f0-91ab-45d1-9f0d-b43b1cd691e6
		summarizeBy: none
		sourceColumn: Quarter

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b46a738c-a8b6-462a-9192-51a4a7728c28
		summarizeBy: none
		sourceColumn: Month Number

	column Month
