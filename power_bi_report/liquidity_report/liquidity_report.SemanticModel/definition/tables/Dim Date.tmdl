		lineageTag: 9435f05c-4142-4904-b465-1ee675e6b5f0
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Number'

	column 'Year Month Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 6a302aad-5932-461a-a16a-470c03b84b5d
		summarizeBy: none
		sourceColumn: Year Month Key

	column 'Year Month'
		dataType: string
		lineageTag: 8b33d7c7-e5bf-44c2-aaef-e4d1a54df478
		summarizeBy: none
		sourceColumn: Year Month
		sortByColumn: 'Year Month Key'

	column 'Month End'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 4ba246bc-d24f-4565-99fc-deaad45e74cf
		summarizeBy: none
		sourceColumn: Month End

		annotation UnderlyingDateTimeDataType = Date

	column 'Is Month End'
		dataType: int64
		formatString: 0
		lineageTag: 9429af63-f328-424b-b51f-a3d0f5259cc8
		summarizeBy: none
		sourceColumn: Is Month End

	column 'Week Start'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: eaec0cba-0042-4e32-8c0f-c4b90c519bcc
		summarizeBy: none
		sourceColumn: Week Start

		annotation UnderlyingDateTimeDataType = Date

	column 'ISO Week'
		dataType: int64
		formatString: 0
		lineageTag: 5d2e0107-e5eb-478c-a5b6-dddee5c67bda
		summarizeBy: none
