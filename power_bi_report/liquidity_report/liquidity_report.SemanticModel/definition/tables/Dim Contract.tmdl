/// Contracts (drill-through only). Not related to Dim Product: the facts carry Product Code.
table 'Dim Contract'
	lineageTag: afc671b0-f662-4c09-adc6-d3d5951200e3

	column 'Contract Id'
		dataType: string
		isHidden
		lineageTag: d15e6c38-21ef-40f2-8daf-9f38dc62ce05
		summarizeBy: none
		sourceColumn: Contract Id

	column 'Product Code'
		dataType: string
		isHidden
		lineageTag: 682cda41-8db0-47f5-b4aa-933f5b644b91
		summarizeBy: none
		sourceColumn: Product Code

	column 'Segment Code'
		dataType: string
		isHidden
		lineageTag: 185b8c39-91bd-435e-9f53-ecacd6ccb48b
		summarizeBy: none
		sourceColumn: Segment Code

	column 'Currency Code'
		dataType: string
		isHidden
		lineageTag: 63f7431c-fe1c-4536-8c41-bdc6b6909de4
		summarizeBy: none
		sourceColumn: Currency Code

	column 'Counterparty Name'
		dataType: string
		lineageTag: 45f33a18-ed9d-46a9-a4a5-cc9089f3977f
		summarizeBy: none
		sourceColumn: Counterparty Name

	column 'Start Date'
		dataType: dateTime
