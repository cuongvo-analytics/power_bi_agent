	partition 'Dim Contract' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_contract.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"contract_id", "product_code", "segment_code", "currency_code", "counterparty_name", "start_date", "maturity_date", "interest_rate", "notional_local"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"contract_id", type text}, {"product_code", type text}, {"segment_code", type text}, {"currency_code", type text}, {"counterparty_name", type text}, {"start_date", type date}, {"maturity_date", type date}, {"interest_rate", type number}, {"notional_local", Currency.Type}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"contract_id", "Contract Id"}, {"product_code", "Product Code"}, {"segment_code", "Segment Code"}, {"currency_code", "Currency Code"}, {"counterparty_name", "Counterparty Name"}, {"start_date", "Start Date"}, {"maturity_date", "Maturity Date"}, {"interest_rate", "Interest Rate"}, {"notional_local", "Notional Local"}})
				in
				    Renamed

