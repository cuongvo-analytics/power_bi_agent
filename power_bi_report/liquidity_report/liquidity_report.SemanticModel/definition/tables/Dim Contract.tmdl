		annotation UnderlyingDateTimeDataType = Date

	column 'Maturity Date'
		dataType: dateTime
		formatString: yyyy-mm-dd
		lineageTag: 7e0a9884-c9f2-4f9d-922c-da06946d6043
		summarizeBy: none
