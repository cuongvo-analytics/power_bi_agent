/// Reference LCR results from the source: one row per month-end x scenario. Reconciliation only.
table 'Ref Liquidity Metrics'
	lineageTag: 9d816882-3d92-41bf-9d9a-1984946a1e16

	column Date
		dataType: dateTime
		isHidden
		formatString: yyyy-mm-dd
		lineageTag: ff6cf53f-cb74-478e-817e-e4fdd83dc1c8
		summarizeBy: none
		sourceColumn: Date

	column 'Scenario Key'
		dataType: string
		isHidden
		lineageTag: 3ac13c3d-0e59-4db8-9223-5e64e983d469
		summarizeBy: none
		sourceColumn: Scenario Key

	column 'HQLA L1 RC'
		dataType: decimal
		isHidden
		formatString: #,##0.00
		lineageTag: 5955223a-04d9-4aa2-b9d5-f1f01edfb73a
		summarizeBy: none
		sourceColumn: HQLA L1 RC

	column 'HQLA L2A RC'
		dataType: decimal
		isHidden
		formatString: #,##0.00
		lineageTag: 0f39f442-4e52-4334-a4f7-ab4def51f376
