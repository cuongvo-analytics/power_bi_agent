model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table _Measures
ref table 'Dim Date'
ref table 'Dim Scenario'
ref table 'Dim Currency'
ref table 'Dim Segment'
ref table 'Dim Product'
ref table 'Dim Time Bucket'
ref table 'Dim Contract'
ref table 'Fact Bank Position'
ref table 'Fact HQLA Holding'
ref table 'Fact Bank CF Contractual'
ref table 'Fact Bank CF Stressed'
ref table 'Fact FX Rate'
ref table 'Scenario Parameter'
ref table 'Ref Liquidity Metrics'
ref table 'HQLA Bridge Step'

ref cultureInfo en-US

