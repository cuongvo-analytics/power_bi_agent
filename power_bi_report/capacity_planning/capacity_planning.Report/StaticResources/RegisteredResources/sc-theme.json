{
  "name": "SC Brand",
  "dataColors": [
    "#020B43",
    "#0473EA",
    "#38D200",
    "#525355",
    "#9AC7F7",
    "#4E547B",
    "#1E7A00",
    "#A8A9AA",
    "#9BE87F",
    "#CDE3FB"
  ],
  "background": "#FFFFFF",
  "foreground": "#020B43",
  "tableAccent": "#0473EA",
  "good": "#1E7A00",
  "neutral": "#525355",
  "bad": "#C23B22",
  "maximum": "#020B43",
  "center": "#0473EA",
  "minimum": "#EAF3FE",
  "null": "#E5E7EB",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "'SC Prosper Sans', 'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#020B43"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "'SC Prosper Sans', 'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#020B43"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "'SC Prosper Sans', 'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
      "color": "#020B43"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "'SC Prosper Sans', 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
      "color": "#525355"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#020B43"
              }
            },
            "fontSize": 11,
            "fontFamily": "'SC Prosper Sans', 'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
            "bold": true,
            "alignment": "left"
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "radius": 6
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "valueAxis": [
          {
            "gridlineShow": true,
            "gridlineColor": {
              "solid": {
                "color": "#EDF2F7"
              }
            },
            "gridlineStyle": "dotted",
            "labelColor": {
              "solid": {
                "color": "#525355"
              }
            },
            "fontFamily": "'SC Prosper Sans', 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "fontSize": 9
          }
        ],
        "categoryAxis": [
          {
            "gridlineShow": false,
            "labelColor": {
              "solid": {
                "color": "#525355"
              }
            },
            "fontFamily": "'SC Prosper Sans', 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "fontSize": 9
          }
        ],
        "legend": [
          {
            "show": true,
            "position": "Top",
            "labelColor": {
              "solid": {
                "color": "#525355"
              }
            },
            "fontFamily": "'SC Prosper Sans', 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
            "fontSize": 9
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F7FA"
              }
            }
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#020B43"
              }
            },
            "fontSize": 22,
            "fontFamily": "'SC Prosper Sans', 'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#525355"
              }
            },
            "fontSize": 9
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#020B43"
              }
            },
            "fontFamily": "'SC Prosper Sans', 'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
            "fontSize": 9
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#020B43"
              }
            },
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontColor": {
              "solid": {
                "color": "#020B43"
              }
            },
            "fontSize": 9
          }
        ],
        "subTotals": [
          {
            "fontColor": {
              "solid": {
                "color": "#020B43"
              }
            },
            "backColor": {
              "solid": {
                "color": "#EAF3FE"
              }
            },
            "fontFamily": "'SC Prosper Sans', 'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif"
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#020B43"
              }
            },
            "fontFamily": "'SC Prosper Sans', 'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif"
          }
        ],
        "grid": [
          {
            "gridHorizontal": true,
            "gridHorizontalColor": {
              "solid": {
                "color": "#E2E8F0"
              }
            },
            "gridVertical": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#020B43"
              }
            },
            "fontFamily": "'SC Prosper Sans', 'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif",
            "fontSize": 9
          }
        ],
        "values": [
          {
            "fontSize": 9
          }
        ],
        "total": [
          {
            "fontColor": {
              "solid": {
                "color": "#020B43"
              }
            },
            "backColor": {
              "solid": {
                "color": "#EAF3FE"
              }
            },
            "fontFamily": "'SC Prosper Sans', 'Segoe UI Semibold', wf_segoe-ui_semibold, helvetica, arial, sans-serif"
          }
        ]
      }
    },
    "waterfallChart": {
      "*": {
        "sentimentColors": [
          {
            "increaseFill": {
              "solid": {
                "color": "#38D200"
              }
            },
            "decreaseFill": {
              "solid": {
                "color": "#C23B22"
              }
            },
            "totalFill": {
              "solid": {
                "color": "#020B43"
              }
            }
          }
        ]
      }
    },
    "slicer": {
      "*": {
        "header": [
          {
            "fontColor": {
              "solid": {
                "color": "#525355"
              }
            },
            "textSize": 9,
            "fontFamily": "'SC Prosper Sans', 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif"
          }
        ],
        "items": [
          {
            "fontColor": {
              "solid": {
                "color": "#020B43"
              }
            },
            "textSize": 10,
            "fontFamily": "'SC Prosper Sans', 'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif"
          }
        ]
      }
    },
    "textbox": {
      "*": {
        "background": [
          {
            "show": false
          }
        ],
        "border": [
          {
            "show": false
          }
        ]
      }
    }
  }
}