model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["Dim Date","Dim Team","Dim Role","Dim Person","Dim Project","Fact Capacity","Fact Demand","Fact Timesheet","Public Holiday","DataFolder"]

ref table _Measures
ref table 'Dim Date'
ref table 'Dim Team'
ref table 'Dim Role'
ref table 'Dim Person'
ref table 'Dim Project'
ref table 'Fact Capacity'
ref table 'Fact Demand'
ref table 'Fact Timesheet'
ref table 'Public Holiday'

ref cultureInfo en-US

