/// Teams: one row per team (4).
table 'Dim Team'
	lineageTag: b85a7e6b-90d9-4df2-9ac6-4ce53c9233a7

	column 'Team Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 072488b3-36be-4c23-ad0f-fca47df420f2
		summarizeBy: none
		sourceColumn: Team Key

	column 'Team Name'
		dataType: string
		lineageTag: 6184f3ea-0ed2-40a7-94cf-d9707e8bb00a
		summarizeBy: none
		sourceColumn: Team Name

	column Department
		dataType: string
		lineageTag: 0435146a-2cb7-4206-a6eb-bf207f94130c
		summarizeBy: none
		sourceColumn: Department

	column 'Team Lead'
		dataType: string
		lineageTag: eacef302-27da-47e6-9972-fc24d78de5ff
		summarizeBy: none
		sourceColumn: Team Lead

	partition 'Dim Team' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_team.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"team_key", Int64.Type}, {"team_name", type text}, {"department", type text}, {"team_lead", type text}}, "en-US"),
				    Renamed = Table.RenameColumns(Typed, {{"team_key", "Team Key"}, {"team_name", "Team Name"}, {"department", "Department"}, {"team_lead", "Team Lead"}})
				in
				    Renamed

