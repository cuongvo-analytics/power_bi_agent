/// Calendar: one row per day 2026-05-01 to 2027-03-31 with Monday week columns and Period Type (History up to the status week, Plan after). Marked date table.
table 'Dim Date'
	lineageTag: 2af8ee4b-e8db-45b9-ad9b-3de383fcdd4f
	dataCategory: Time

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: e6d3c36a-4a85-406c-a825-a3882aa461c7
		summarizeBy: none
		sourceColumn: Date

		annotation UnderlyingDateTimeDataType = Date

	column 'Date Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: b5bbb8e4-da1b-44ca-a71b-f8cad298dcf0
		summarizeBy: none
		sourceColumn: Date Key

	column Year
		dataType: int64
		formatString: 0
		lineageTag: 72028587-a1ed-43d9-a86e-6cd8b43b9075
		summarizeBy: none
		sourceColumn: Year

	column Quarter
		dataType: string
		lineageTag: 9718a1d6-73d5-4133-b1e1-ff4b19de29f8
		summarizeBy: none
		sourceColumn: Quarter

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 650346e2-ec42-4d3a-8f35-4af5aaa4b66b
		summarizeBy: none
		sourceColumn: Month Number

	column Month
		dataType: string
		lineageTag: e233b4fc-ead0-46dc-a02b-2393b0f2b46c
		summarizeBy: none
		sourceColumn: Month
		sortByColumn: 'Month Number'

	column 'Year Month Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 3899b554-fbe0-4f6d-a3ac-28304506c05c
		summarizeBy: none
		sourceColumn: Year Month Key

	column 'Year Month'
		dataType: string
		lineageTag: 1944a9f4-a222-4e71-affb-550d621c19a6
		summarizeBy: none
		sourceColumn: Year Month
		sortByColumn: 'Year Month Key'

	column 'Week Start'
		dataType: dateTime
		formatString: dd mmm yy
		lineageTag: c81c90d4-d4da-4102-b43b-a5f017f4a247
		summarizeBy: none
		sourceColumn: Week Start

		annotation UnderlyingDateTimeDataType = Date

	column 'ISO Week'
		dataType: int64
		formatString: 0
		lineageTag: 5adebe66-c32f-461f-96d7-b4b5adc1661b
		summarizeBy: none
