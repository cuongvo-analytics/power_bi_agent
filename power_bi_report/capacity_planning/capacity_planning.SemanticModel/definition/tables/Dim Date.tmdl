	partition 'Dim Date' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"date", type date}, {"date_key", Int64.Type}, {"year", Int64.Type}, {"quarter", type text}, {"month_number", Int64.Type}, {"month", type text}, {"year_month_key", Int64.Type}, {"year_month", type text}, {"week_start", type date}, {"iso_week", Int64.Type}, {"iso_year", Int64.Type}, {"year_week", type text}, {"is_working_day", Int64.Type}, {"period_type", type text}}, "en-US"),
				    Flags = Table.TransformColumns(Typed, {{"is_working_day", each _ = 1, type logical}}),
				    Renamed = Table.RenameColumns(Flags, {{"date", "Date"}, {"date_key", "Date Key"}, {"year", "Year"}, {"quarter", "Quarter"}, {"month_number", "Month Number"}, {"month", "Month"}, {"year_month_key", "Year Month Key"}, {"year_month", "Year Month"}, {"week_start", "Week Start"}, {"iso_week", "ISO Week"}, {"iso_year", "ISO Year"}, {"year_week", "Year Week"}, {"is_working_day", "Is Working Day"}, {"period_type", "Period Type"}})
				in
				    Renamed

