	column 'Is Working Day'
		dataType: boolean
		lineageTag: c36e2ec8-9790-4530-af92-be8954677d44
		summarizeBy: none
		sourceColumn: Is Working Day

	column 'Period Type'
		dataType: string
		lineageTag: 3bb25834-9f2a-448b-b104-6dce6c538d92
		summarizeBy: none
