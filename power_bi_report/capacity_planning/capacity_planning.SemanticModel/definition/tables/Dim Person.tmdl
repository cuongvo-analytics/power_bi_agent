	partition 'Dim Person' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_person.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"person_key", Int64.Type}, {"person_name", type text}, {"current_team", type text}, {"current_role", type text}, {"location", type text}, {"employment_type", type text}, {"contract_fte", type number}, {"standard_weekly_hours", type number}, {"cost_rate", type number}, {"utilisation_target_pct", type number}, {"billable_target_pct", type number}, {"start_date", type date}, {"end_date", type date}, {"is_active", Int64.Type}}, "en-US"),
				    Flags = Table.TransformColumns(Typed, {{"is_active", each _ = 1, type logical}}),
				    Renamed = Table.RenameColumns(Flags, {{"person_key", "Person Key"}, {"person_name", "Person Name"}, {"current_team", "Current Team"}, {"current_role", "Current Role"}, {"location", "Location"}, {"employment_type", "Employment Type"}, {"contract_fte", "Contract FTE"}, {"standard_weekly_hours", "Contract Weekly Hours"}, {"cost_rate", "Cost Rate"}, {"utilisation_target_pct", "Utilisation Target Pct"}, {"billable_target_pct", "Billable Target Pct"}, {"start_date", "Start Date"}, {"end_date", "End Date"}, {"is_active", "Is Active"}})
				in
				    Renamed

