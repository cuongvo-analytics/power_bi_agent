	partition 'Dim Project' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_project.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"project_key", Int64.Type}, {"project_code", type text}, {"project_name", type text}, {"portfolio", type text}, {"project_manager", type text}, {"methodology", type text}, {"status", type text}, {"health_rag", type text}, {"is_pipeline", Int64.Type}, {"probability", type number}, {"is_billable", Int64.Type}, {"start_date", type date}, {"finish_date", type date}}, "en-US"),
				    Flags = Table.TransformColumns(Typed, {{"is_pipeline", each _ = 1, type logical}, {"is_billable", each _ = 1, type logical}}),
				    Renamed = Table.RenameColumns(Flags, {{"project_key", "Project Key"}, {"project_code", "Project Code"}, {"project_name", "Project Name"}, {"portfolio", "Portfolio"}, {"project_manager", "Project Manager"}, {"methodology", "Methodology"}, {"status", "Status"}, {"health_rag", "Health RAG"}, {"is_pipeline", "Is Pipeline"}, {"probability", "Probability"}, {"is_billable", "Is Billable"}, {"start_date", "Start Date"}, {"finish_date", "Finish Date"}})
				in
				    Renamed

