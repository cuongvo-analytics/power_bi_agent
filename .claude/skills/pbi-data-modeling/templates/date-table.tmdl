/// Fallback calendar (use the source's own calendar when it ships one). Set the four VARs in the partition
/// for the domain: treasury = history start to the contractual tail with _AsOf = last snapshot month-end;
/// project & capacity = first timesheet / task date to the end of the planning horizon.
/// Week columns (Monday Week Start, ISO week) serve weekly facts. Public holidays: set Is Working Day in Power Query
/// or a holiday merge. Fiscal year is named after the calendar year in which it ends.
table 'Dim Date'
	dataCategory: Time
	lineageTag: <guid>

	column Date
		dataType: dateTime
		isKey
		formatString: Short Date
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date]

	column 'Date Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Date Key]

	column Year
		dataType: int64
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	column Quarter
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Quarter]

	column 'Month Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month Number]

	column Month
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month]
		sortByColumn: 'Month Number'

	column 'Year Month Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month Key]

	column 'Year Month'
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Month]
		sortByColumn: 'Year Month Key'

	column 'Month End'
		dataType: dateTime
		formatString: Short Date
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Month End]

	column 'Fiscal Year Number'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Year Number]

	column 'Fiscal Year'
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Year]
		sortByColumn: 'Fiscal Year Number'

	column 'Fiscal Quarter'
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Quarter]

	column 'Fiscal Month Number'
		dataType: int64
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Month Number]

	column 'Fiscal Period'
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Period]
		sortByColumn: 'Fiscal Period Key'

	column 'Fiscal Period Key'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Fiscal Period Key]

	column 'Is Month End'
		dataType: boolean
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Is Month End]

	column 'Week Start'
		dataType: dateTime
		formatString: Short Date
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Week Start]

	column 'ISO Week'
		dataType: int64
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [ISO Week]

	column 'ISO Year'
		dataType: int64
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [ISO Year]

	column 'Year Week'
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year Week]
		sortByColumn: 'Week Start'

	column 'Is Working Day'
		dataType: boolean
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Is Working Day]

	column 'Days From Asof'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Days From Asof]

	column 'Period Type'
		dataType: string
		lineageTag: <guid>
		summarizeBy: none
		isNameInferred
		sourceColumn: [Period Type]

	hierarchy 'Fiscal Calendar'
		lineageTag: <guid>

		level 'Fiscal Year'
			lineageTag: <guid>
			column: 'Fiscal Year'

		level 'Fiscal Quarter'
			lineageTag: <guid>
			column: 'Fiscal Quarter'

		level 'Fiscal Period'
			lineageTag: <guid>
			column: 'Fiscal Period'

		level Date
			lineageTag: <guid>
			column: Date

	partition 'Dim Date' = calculated
		mode: import
		source =
				VAR _FyStart = 1    // fiscal year start month: 1 = Jan, 4 = Apr, 7 = Jul, 10 = Oct
				VAR _AsOf = TODAY ()      // as-of / status date. Treasury: MAX ( 'Fact Bank Position'[Date] )
				VAR _MinDate = DATE ( 2020, 1, 1 )   // first date in the facts, e.g. MIN ( 'Fact Timesheet'[Date] )
				VAR _MaxDate = _AsOf + 365            // last future date the facts hold (projection, contractual tail, planned weeks)
				VAR _Start = DATE ( YEAR ( _MinDate ), 1, 1 )
				VAR _End = DATE ( YEAR ( _MaxDate ) + 1, 12, 31 )
				RETURN
				    ADDCOLUMNS (
				        CALENDAR ( _Start, _End ),
				        "Date Key", YEAR ( [Date] ) * 10000 + MONTH ( [Date] ) * 100 + DAY ( [Date] ),
				        "Year", YEAR ( [Date] ),
				        "Quarter", "Q" & QUARTER ( [Date] ),
				        "Month Number", MONTH ( [Date] ),
				        "Month", FORMAT ( [Date], "MMM" ),
				        "Year Month Key", YEAR ( [Date] ) * 100 + MONTH ( [Date] ),
				        "Year Month", FORMAT ( [Date], "YYYY-MM" ),
				        "Month End", EOMONTH ( [Date], 0 ),
				        "Fiscal Year Number", YEAR ( [Date] ) + IF ( _FyStart > 1 && MONTH ( [Date] ) >= _FyStart, 1, 0 ),
				        "Fiscal Year", "FY" & ( YEAR ( [Date] ) + IF ( _FyStart > 1 && MONTH ( [Date] ) >= _FyStart, 1, 0 ) ),
				        "Fiscal Month Number", MOD ( MONTH ( [Date] ) - _FyStart, 12 ) + 1,
				        "Fiscal Quarter", "FQ" & ( INT ( MOD ( MONTH ( [Date] ) - _FyStart, 12 ) / 3 ) + 1 ),
				        "Fiscal Period", "P" & FORMAT ( MOD ( MONTH ( [Date] ) - _FyStart, 12 ) + 1, "00" ),
				        "Fiscal Period Key", MOD ( MONTH ( [Date] ) - _FyStart, 12 ) + 1,
				        "Is Month End", [Date] = EOMONTH ( [Date], 0 ),
				        "Week Start", [Date] - WEEKDAY ( [Date], 2 ) + 1,
				        "ISO Week", WEEKNUM ( [Date], 21 ),
				        "ISO Year", YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 ),
				        "Year Week", FORMAT ( YEAR ( [Date] - WEEKDAY ( [Date], 2 ) + 4 ), "0000" ) & "-W" & FORMAT ( WEEKNUM ( [Date], 21 ), "00" ),
				        "Is Working Day", WEEKDAY ( [Date], 2 ) <= 5,
				        "Days From Asof", INT ( [Date] - _AsOf ),
				        "Period Type", SWITCH ( TRUE (), [Date] < _AsOf, "History", [Date] = _AsOf, "As-of",
				                                [Date] <= _AsOf + 365, "Projection", "Beyond horizon" )
				    )
